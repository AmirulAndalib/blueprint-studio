    "call_service": {"domain": "homeassistant", "service": "update_entity", "service_data": {"entity_id": "sensor.fixture"}},
    "convert_to_blueprint": {"content": "alias: Fixture\ntriggers: []\nactions: []\n", "blueprint_name": "Fixture"},
    "parse_blueprint_inputs": {"content": "blueprint:\n  name: Fixture\n  domain: automation\n  input: {}\n"},
    "instantiate_blueprint": {"content": "blueprint:\n  name: Fixture\n  domain: automation\n  input: {}\n", "input_values": {}, "name": "Fixture"},
    "reload_yaml": {"domain": "automation"}
  },
  "sftp_actions": [
    "sftp_test", "sftp_list", "sftp_read", "sftp_write", "sftp_create",
    "sftp_delete", "sftp_delete_multi", "sftp_rename", "sftp_mkdir",
    "sftp_copy", "sftp_upload_folder", "sftp_download_folder",
    "sftp_prepare_stream", "sftp_serve_file"
  ],
  "sftp_connection": {
    "host": "sftp.example.invalid",
    "port": 22,
    "username": "fixture",
    "auth": {"type": "password", "password": "<secret>"}
  },
