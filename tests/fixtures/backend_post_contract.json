    "git_hard_reset": {"remote": "origin", "branch": "main"},
    "git_delete_remote_branch": {"branch": "fixture"},
    "git_checkout_branch": {"branch": "main"},
    "git_create_branch": {"name": "fixture", "checkout": true},
    "git_delete_local_branch": {"branch": "fixture", "force": false},
    "git_merge_branch": {"branch": "fixture"},
    "git_resolve_conflict": {"path": "fixture.yaml", "resolution": "ours"},
    "git_stage": {"files": ["fixture.yaml"]},
    "git_unstage": {"files": ["fixture.yaml"]},
    "git_reset": {"files": ["fixture.yaml"]},
    "git_stop_tracking": {"files": ["fixture.yaml"]},
    "git_set_credentials": {"username": "fixture", "token": "<secret>"},
    "gitea_push": {"commit_message": "Fixture commit"},
    "gitea_set_credentials": {"url": "https://gitea.example.invalid", "username": "fixture", "token": "<secret>"},
    "gitea_add_remote": {"url": "https://gitea.example.invalid/fixture/repository.git"},
    "gitea_create_repo": {"repo_name": "fixture", "is_private": true},
    "ai_query": {"query": "Create a fixture automation", "ai_type": "hass", "task_mode": "generate", "include_file_context": true, "include_metadata": true},
    "ai_preview_context": {"query": "Create a fixture automation", "ai_type": "hass", "task_mode": "generate", "include_file_context": true, "include_metadata": true},
    "ai_get_models": {"ai_type": "cloud", "cloud_provider": "openai"},
    "ai_apply_proposal": {"proposal_id": "fixture-proposal-id"},
    "ai_undo_proposal": {"undo_id": "fixture-undo-id"},
    "ai_cancel": {"request_id": "fixture-request-id"},
    "ai_revise_proposal": {"proposal_id": "fixture-proposal-id", "path": "fixture.yaml", "new_content": "alias: Revised fixture\n"},
    "ai_reject_proposal": {"proposal_id": "fixture-proposal-id"},
    "github_create_repo": {"repo_name": "fixture", "is_private": true},
    "github_set_default_branch": {"branch": "main"},
    "github_device_flow_start": {"client_id": "fixture-client"},
    "github_device_flow_poll": {"client_id": "fixture-client", "device_code": "fixture-code"},
