    "sftp_list": {"path": "/", "show_hidden": false},
    "sftp_read": {"path": "/fixture.yaml"},
    "sftp_write": {"path": "/fixture.yaml", "content": "fixture\n"},
    "sftp_create": {"path": "/fixture.yaml", "content": "", "overwrite": false},
    "sftp_delete": {"path": "/fixture.yaml"},
    "sftp_delete_multi": {"paths": ["/fixture-a", "/fixture-b"]},
    "sftp_rename": {"source": "/fixture-a", "destination": "/fixture-b", "overwrite": false},
    "sftp_mkdir": {"path": "/fixture"},
    "sftp_copy": {"source": "/fixture-a", "destination": "/fixture-b", "overwrite": false},
    "sftp_upload_folder": {"path": "/fixture", "zip_data": "<base64-zip>", "mode": "merge", "overwrite": false},
    "sftp_download_folder": {"path": "/fixture"},
    "sftp_prepare_stream": {"path": "/fixture.yaml", "stream_type": "file"},
    "sftp_serve_file": {"path": "/fixture.yaml"}
  }
