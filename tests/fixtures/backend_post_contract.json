    "save_settings": {"settings": {}},
    "write_file": {"path": "automations.yaml", "content": "[]\n"},
    "create_file": {"path": "fixture.yaml", "content": "", "overwrite": false},
    "create_folder": {"path": "fixture"},
    "delete": {"path": "fixture.yaml"},
    "copy": {"source": "fixture.yaml", "destination": "fixture-copy.yaml", "overwrite": false},
    "rename": {"source": "fixture-copy.yaml", "destination": "fixture-renamed.yaml", "overwrite": false},
    "upload_file": {"path": "fixture.bin", "content": "Zml4dHVyZQ==", "is_base64": true, "overwrite": false},
    "upload_folder": {"path": "fixture", "zip_data": "<base64-zip>", "mode": "merge", "overwrite": false},
    "prepare_download_multi": {"paths": ["configuration.yaml"], "progress_id": "fixture-progress"},
    "cancel_zip": {"progress_id": "fixture-progress"},
    "download_multi": {"paths": ["configuration.yaml"], "progress_id": "fixture-progress"},
    "delete_multi": {"paths": ["fixture-a", "fixture-b"]},
    "move_multi": {"paths": ["fixture-a"], "destination": "fixture-folder"},
