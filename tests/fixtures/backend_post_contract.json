    "global_replace": {"query": "old", "replacement": "new", "case_sensitive": false, "use_regex": false, "match_word": false},
    "check_yaml": {"content": "automation: []\n"},
    "check_jinja": {"content": "{{ states('sensor.fixture') }}"},
    "check_json": {"content": "{}"},
    "check_python": {"content": "value = 1\n"},
    "check_javascript": {"content": "const value = 1;\n"},
    "check_syntax": {"content": "automation: []\n", "file_path": "fixture.yaml"},
    "terminal_exec": {"command": "pwd"},
    "git_diff_commit": {"hash": "HEAD"},
    "git_push": {"commit_message": "Fixture commit"},
    "git_commit": {"commit_message": "Fixture commit"},
    "git_show": {"path": "configuration.yaml"},
    "git_add_remote": {"name": "origin", "url": "https://example.invalid/repository.git"},
    "git_remove_remote": {"name": "origin"},
    "git_rename_branch": {"old_name": "old", "new_name": "new"},
