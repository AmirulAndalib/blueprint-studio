    "check_json", "check_python", "check_javascript", "check_syntax",
    "terminal_exec", "git_status", "git_log", "git_diff_commit", "git_pull",
    "git_push", "git_push_only", "git_commit", "git_show", "git_init",
    "git_add_remote", "git_remove_remote", "git_delete_repo",
    "git_repair_index", "git_rename_branch", "git_merge_unrelated",
    "git_force_push", "git_hard_reset", "git_delete_remote_branch",
    "git_checkout_branch", "git_create_branch", "git_delete_local_branch",
    "git_merge_branch", "git_get_conflict_files", "git_resolve_conflict",
